# Move servo to a goal position
uint8 servo_id        # Servo ID (0~253, 254=broadcast)
int32 goal_position   # Goal position (0~1023)
int32 playtime_ms     # Execution time in milliseconds (0~2856)
uint8 led_color       # LED color (0=off, 1=green, 2=blue, 3=red, 4=cyan, 5=yellow, 6=pink, 7=white)
---
bool success
string message
