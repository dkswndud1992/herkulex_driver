# Set PID gain values for a servo
# Gains are written to RAM (temporary) or EEP (permanent, needs reboot)
uint8 servo_id          # Servo ID (0~253, 254=broadcast)

# Memory type
uint8 MEMORY_RAM=0      # RAM (temporary, lost on reboot)
uint8 MEMORY_EEP=1      # EEP/ROM (permanent, survives reboot)
uint8 memory_type       # 0=RAM, 1=EEP

# Position PID Gains (2 bytes each, range 0~32767)
# Set to -1 to leave unchanged
int32 kp                # Proportional gain (default: 440)
int32 kd                # Derivative gain (default: 8000)
int32 ki                # Integral gain (default: 0)
int32 feedforward1      # Position feedforward 1st gain (default: 0)
int32 feedforward2      # Position feedforward 2nd gain (default: 0)

# Velocity Gains (DRS-0x02 series only: DRS-0102, DRS-0402, DRS-0602)
# Ignored on non-0x02 models. Set to -1 to leave unchanged.
int32 velocity_kp       # Velocity P gain (default: 100, actual = value/64)
int32 velocity_ki       # Velocity I gain (default: 12000, actual = value/16384)
---
bool success
string message
