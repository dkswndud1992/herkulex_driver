<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>herkulex_driver</name>
  <version>1.0.0</version>
  <description>ROS2 driver for Dongbu HerkuleX DRS-0101/DRS-0201 smart servo motors.
    Provides serial communication, position/speed control, and status monitoring via ROS2 services and topics.
  </description>

  <maintainer email="dkswndud1992@naver.com">johny</maintainer>
  <license>LGPL-2.1-or-later</license>

  <url type="website">https://github.com/dkswndud1992/herkulex_driver</url>
  <author>Based on Arduino library by Alessandro Giacomel</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_components</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>builtin_interfaces</build_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
